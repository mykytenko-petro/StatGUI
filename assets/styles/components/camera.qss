QLabel#CameraTitle {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
}

QFrame#CameraLiveBadge {
    background-color: #042721;
    border: 1px solid #059669;
    border-radius: 10px;
}

QLabel#LiveBadgeDot {
    color: #00e676;
    font-size: 9px;
}

QLabel#LiveBadgeText {
    color: #10b981;
    font-weight: bold;
    font-size: 11px;
}

QFrame#CameraFeedContainer {
    background-color: #010a18;
    border: 1px solid #0d284f;
    border-radius: 8px;
}

QLabel#CameraFeedDisplay {
    border-radius: 8px;
    background-color: transparent;
}

QLabel#CameraOverlayBadge {
    background-color: rgba(3, 14, 30, 0.78);
    border: 1px solid #1a3860;
    border-radius: 4px;
    color: #dbe4f0;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 8px;
}

QLabel#CameraOverlayBadgeLive {
    background-color: rgba(3, 14, 30, 0.78);
    border: 1px solid #1a3860;
    border-radius: 4px;
    color: #00e676;
    font-size: 11px;
    font-weight: bold;
    padding: 3px 8px;
}